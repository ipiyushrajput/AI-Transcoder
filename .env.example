# Copy to .env (development) or /etc/ai-transcoder.env (production).
# Never commit the real file — it holds the database password.

# --- MySQL ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Visionular-Transcoder
# Write the password exactly as it is — no quoting or %-encoding needed here.
# The database is created on first start if it does not exist.
# One full URL instead of the five above (here '@' in a password must be %40):
# DATABASE_URL=mysql+pymysql://root:pass%40word@localhost:3306/Visionular-Transcoder?charset=utf8mb4

# --- API --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
TRANSCODER_CONFIG=config.json
CORS_ORIGINS=*

# --- Job execution ----------------------------------------------------------
# Jobs the API runs at once. CPU use is governed by the shared CPU budget below,
# not by this, so raising it does not oversubscribe the cores: extra jobs wait
# for cores. Each running job does need scratch disk (~3x its source file).
MAX_CONCURRENT_JOBS=2
# Cores shared by every transcode on this server — API jobs and any
# `python app.py` runs alike. Defaults to the CPU count. Use one value for all.
# WZ_CPU_BUDGET=32
# Per-channel log tree: LOG_ROOT/<channel>/<job_id>/
LOG_ROOT=logs
# Parent for scratch directories (downloaded input, clips, staged output).
# Needs free space of roughly 3x the source file.
WORK_ROOT=/var/tmp/ai-transcoder
SERVER_LOG_DIR=logs/_server
# How often live progress is flushed to the database, in seconds.
PROGRESS_SYNC_SECONDS=5
# After a restart, queue PENDING jobs again (1) or mark them failed (0).
REQUEUE_PENDING_ON_START=1
# Seconds gunicorn waits for running jobs to be interrupted on stop.
GRACEFUL_TIMEOUT=120

# --- Time limits ------------------------------------------------------------
# Stop an FFmpeg run whose output position has not advanced for this long.
WZ_FFMPEG_STALL_SECONDS=600
# Hard limit per FFmpeg command; 0 = none (a long encode is never cut short).
WZ_FFMPEG_MAX_SECONDS=0
WZ_FFPROBE_TIMEOUT_SECONDS=300

# --- AWS --------------------------------------------------------------------
# Credentials come from the instance role / ~/.aws / the standard environment.
# Set a region only if the bucket's region is not the instance's own.
# AWS_REGION=us-west-2

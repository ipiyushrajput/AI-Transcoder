# Copy to .env (development) or /etc/ai-transcoder.env (production).
# Never commit the real file — it holds the database password.

# --- PostgreSQL -------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=transcoder
DB_PASSWORD=ChangeMe_StrongPassword
DB_NAME=ai_transcoder
# One full URL instead of the five above (encode @ as %40 in the password):
# DATABASE_URL=postgresql+psycopg2://transcoder:pass@127.0.0.1:5432/ai_transcoder

# --- API --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
TRANSCODER_CONFIG=config.json
CORS_ORIGINS=*

# --- Job execution ----------------------------------------------------------
# Concurrent transcodes. Each one already uses several FFmpeg processes, so
# keep this low relative to CPU count.
MAX_CONCURRENT_JOBS=2
# Per-channel log tree: LOG_ROOT/<channel>/<job_id>/
LOG_ROOT=logs
# Parent for scratch directories (downloaded input, clips, staged output).
# Needs free space of roughly 3x the source file.
WORK_ROOT=/var/tmp/ai-transcoder
SERVER_LOG_DIR=logs/_server
# How often live progress is flushed to the database, in seconds.
PROGRESS_SYNC_SECONDS=5

# --- AWS --------------------------------------------------------------------
# Credentials come from the instance role / ~/.aws / the standard environment.
# Set a region only if the bucket's region is not the instance's own.
# AWS_REGION=us-west-2

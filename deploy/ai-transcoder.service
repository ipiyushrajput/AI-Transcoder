[Unit]
Description=AI-Transcoder API
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ai-transcoder
EnvironmentFile=/etc/ai-transcoder.env
ExecStart=/opt/ai-transcoder/.venv/bin/gunicorn \
    -c /opt/ai-transcoder/deploy/gunicorn.conf.py \
    "api.app:create_app()"
Restart=on-failure
RestartSec=5
KillMode=mixed
# Running jobs are interrupted and recorded on stop (see gunicorn.conf.py,
# graceful_timeout 120s); allow comfortably longer than that.
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
